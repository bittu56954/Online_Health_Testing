{
  "name": "mediscan-fullstack",
  "version": "1.0.0",
  "type": "module",
  "description": "MEDISCAN - Full-Stack Medicine Information Scanner Web Application (MERN)",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix Backend install && npm --prefix React install",
    "build": "cd React && npm install && npx vite build",
    "start": "npm --prefix Backend start",
    "dev:backend": "npm --prefix Backend run dev",
    "dev:frontend": "npm --prefix React run dev",
    "dev": "npx --prefix React concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"yellow.bold,cyan.bold\" \"npm --prefix Backend run dev\" \"npm --prefix React run dev\"",
    "seed": "npm --prefix Backend run seed"
  },
  "dependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.475.0",
    "mongodb-memory-server": "^10.1.4",
    "mongoose": "^8.13.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "sharp": "^0.35.3",
    "tesseract.js": "^5.1.1",
    "vite": "^8.2.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
