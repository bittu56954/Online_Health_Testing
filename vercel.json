{
  "version": 2,
  "buildCommand": "npm install && cd React && npm install && npx vite build",
  "outputDirectory": "React/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
