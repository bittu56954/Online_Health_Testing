{
  "version": 2,
  "buildCommand": "cd React && npm install && npm run build",
  "outputDirectory": "React/dist",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
